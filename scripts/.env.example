# Логин Confluence для синхронизации графика (файл НЕ коммитится).
# Скопируй этот файл в scripts/.env и заполни своими значениями.
# На macOS также подойдёт ~/.otp/confluence.env, на Windows — старый путь Hermes.
# Вместо файла можно задать переменные окружения CONFLUENCE_LOGIN / CONFLUENCE_PASSWORD.
CONFLUENCE_LOGIN=ivanov
CONFLUENCE_PASSWORD=секрет
